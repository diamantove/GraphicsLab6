<Window x:Class="PolyhedraLab.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Лабораторная №6 — Многогранники и матрицы" Width="1220" Height="900"
 MinWidth="940" MinHeight="640" Loaded="Window_Loaded">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#EAF0F6" Padding="10">
   <StackPanel>
    <TextBlock x:Name="ModelInfo" TextWrapping="Wrap"/>
    <TextBlock x:Name="Status" Text="Готово" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer DockPanel.Dock="Left" Width="380" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="5">
    <GroupBox Header="Многогранник">
     <StackPanel>
      <ComboBox x:Name="SolidChoice" SelectedIndex="1" SelectionChanged="SolidChoice_SelectionChanged">
       <ComboBoxItem Content="Тетраэдр"/><ComboBoxItem Content="Гексаэдр (куб)"/>
       <ComboBoxItem Content="Октаэдр"/><ComboBoxItem Content="Икосаэдр"/><ComboBoxItem Content="Додекаэдр"/>
      </ComboBox>
      <Button Content="Восстановить исходную фигуру" Click="Reset_Click"/>
      <TextBlock Text="Выбор фигуры сбрасывает её преобразования." TextWrapping="Wrap"/>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="Смещение">
     <StackPanel>
      <UniformGrid Columns="3"><TextBlock Text="dx"/><TextBlock Text="dy"/><TextBlock Text="dz"/></UniformGrid>
      <UniformGrid Columns="3"><TextBox x:Name="Dx" Text="1"/><TextBox x:Name="Dy" Text="0"/><TextBox x:Name="Dz" Text="0"/></UniformGrid>
      <Button Content="Сместить" Click="Translate_Click"/>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="Поворот вокруг координатной оси">
     <StackPanel>
      <DockPanel><TextBlock Text="Ось:" VerticalAlignment="Center"/>
       <ComboBox x:Name="AxisChoice" SelectedIndex="1" Width="70"><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/></ComboBox>
       <TextBlock Text="Угол, °:" VerticalAlignment="Center"/><TextBox x:Name="Angle" Text="30"/>
      </DockPanel>
      <Button Content="Вокруг оси через начало координат" Click="RotateOrigin_Click"/>
      <Button Content="Вокруг параллельной оси через центр" Click="RotateCenter_Click"/>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="Масштабирование">
     <StackPanel>
      <UniformGrid Columns="3"><TextBlock Text="sx"/><TextBlock Text="sy"/><TextBlock Text="sz"/></UniformGrid>
      <UniformGrid Columns="3"><TextBox x:Name="Sx" Text="1.2"/><TextBox x:Name="Sy" Text="1.2"/><TextBox x:Name="Sz" Text="1.2"/></UniformGrid>
      <Button Content="Относительно начала координат" Click="ScaleOrigin_Click"/>
      <Button Content="Относительно центра многогранника" Click="ScaleCenter_Click"/>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="Отражение">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Отразить" Click="Reflect_Click"/>
      <ComboBox x:Name="PlaneChoice" SelectedIndex="0"><ComboBoxItem Content="XY"/><ComboBoxItem Content="XZ"/><ComboBoxItem Content="YZ"/></ComboBox>
     </DockPanel>
    </GroupBox>
    <GroupBox Header="Вращение вокруг произвольной прямой A → B">
     <StackPanel>
      <UniformGrid Columns="4"><TextBlock Text="Точка"/><TextBlock Text="X"/><TextBlock Text="Y"/><TextBlock Text="Z"/></UniformGrid>
      <UniformGrid Columns="4"><TextBlock Text="A"/><TextBox x:Name="Ax" Text="0"/><TextBox x:Name="Ay" Text="0"/><TextBox x:Name="Az" Text="0"/></UniformGrid>
      <UniformGrid Columns="4"><TextBlock Text="B"/><TextBox x:Name="Bx" Text="1"/><TextBox x:Name="By" Text="1"/><TextBox x:Name="Bz" Text="1"/></UniformGrid>
      <DockPanel><TextBlock Text="Угол, °:" VerticalAlignment="Center"/><TextBox x:Name="LineAngle" Text="30"/></DockPanel>
      <Button Content="Повернуть вокруг A → B" Click="RotateLine_Click"/>
      <TextBlock Text="Положительный угол — по правилу правой руки. Оранжевый пунктир показывает отрезок A–B." TextWrapping="Wrap"/>
     </StackPanel>
    </GroupBox>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Margin="6">
   <StackPanel DockPanel.Dock="Top">
    <DockPanel>
     <TextBlock Text="Проекция:" VerticalAlignment="Center"/>
     <ComboBox x:Name="ProjectionChoice" SelectedIndex="0" SelectionChanged="View_Changed" Width="250">
      <ComboBoxItem Content="Аксонометрическая (изометрия)"/><ComboBoxItem Content="Перспективная"/>
     </ComboBox>
    </DockPanel>
    <DockPanel Margin="3,6">
     <TextBlock Text="Масштаб вида:" VerticalAlignment="Center"/>
     <CheckBox x:Name="AxesCheck" DockPanel.Dock="Right" Content="Оси" IsChecked="True" VerticalAlignment="Center" Checked="View_Changed" Unchecked="View_Changed"/>
     <Slider x:Name="Zoom" Minimum="0.2" Maximum="3" Value="1" ValueChanged="Zoom_Changed" Margin="10,0"/>
    </DockPanel>
    <TextBlock Text="Правая система координат: Y вверх. Масштаб вида не меняет модель. Камера фиксирована; все операции изменяют координаты вершин." TextWrapping="Wrap" Margin="3,5"/>
   </StackPanel>
   <Border BorderBrush="#BDC7D0" BorderThickness="1" Background="#FAFCFF">
    <Canvas x:Name="DrawingCanvas" ClipToBounds="True" SizeChanged="Canvas_SizeChanged"/>
   </Border>
  </DockPanel>
 </DockPanel>
</Window>
